# Vagrantfile — Dựng cụm 4 VM: 1 control-plane + 3 worker
#
# Cấu hình khớp với môi trường thực tế của nhóm (VMware Workstation):
#   Subnet host-only: 192.168.243.0/24
#   k3s-master  : 192.168.243.10 — 3GB RAM, 2 vCPU
#   k3s-worker1 : 192.168.243.11 — 2GB RAM, 2 vCPU
#   k3s-worker2 : 192.168.243.12 — 2GB RAM, 2 vCPU
#   k3s-worker3 : 192.168.243.13 — 2GB RAM, 2 vCPU
#
# LƯU Ý INTERFACE (quan trọng cho setup-base-node.sh / join-worker.sh):
#   VMware Workstation : ens33 (host-only), ens37 (NAT)
#   VirtualBox         : enp0s8 (private_network), enp0s3 (NAT/default)
#   → Nếu chạy trên VirtualBox, sửa biến NET_IF trong k3s-setup scripts.
#
# Cách dùng:
#   vagrant up                        # dựng tất cả VM
#   vagrant up k3s-master             # dựng riêng 1 VM
#   vagrant ssh k3s-master            # SSH vào VM
#   vagrant halt                      # tắt tất cả
#   vagrant destroy -f                # xóa tất cả
#
# Join worker (sau khi master đã lên):
#   TOKEN=$(vagrant ssh k3s-master -c "sudo cat /var/lib/rancher/k3s/server/node-token" 2>/dev/null | tr -d '\r')
#   vagrant ssh k3s-worker1 -c "sudo /vagrant/../k3s-setup/join-worker.sh 192.168.243.10 $TOKEN"

Vagrant.configure("2") do |config|
  # Box dùng được cho cả VirtualBox lẫn VMware Workstation
  config.vm.box = "bento/ubuntu-22.04"

  # ---- Control-plane node ----
  config.vm.define "k3s-master" do |node|
    node.vm.hostname = "k3s-master"
    node.vm.network "private_network", ip: "192.168.243.10"

    node.vm.provider "vmware_workstation" do |vb|
      vb.memory = 3072
      vb.cpus   = 2
    end
    node.vm.provider "vmware_desktop" do |vb|
      vb.memory = 3072
      vb.cpus   = 2
    end
    node.vm.provider "virtualbox" do |vb|
      vb.memory = 3072
      vb.cpus   = 2
    end

    node.vm.provision "shell", path: "../k3s-setup/setup-base-node.sh"
    node.vm.provision "shell", path: "../k3s-setup/install-control-plane.sh"
  end

  # ---- Worker nodes (x3) ----
  (1..3).each do |i|
    config.vm.define "k3s-worker#{i}" do |node|
      node.vm.hostname = "k3s-worker#{i}"
      node.vm.network "private_network", ip: "192.168.243.#{10 + i}"

      node.vm.provider "vmware_workstation" do |vb|
        vb.memory = 2048
        vb.cpus   = 2
      end
      node.vm.provider "vmware_desktop" do |vb|
        vb.memory = 2048
        vb.cpus   = 2
      end
      node.vm.provider "virtualbox" do |vb|
        vb.memory = 2048
        vb.cpus   = 2
      end

      node.vm.provision "shell", path: "../k3s-setup/setup-base-node.sh"
      # join-worker.sh cần TOKEN từ master — chạy thủ công sau khi master Ready:
      #   TOKEN=$(sudo cat /var/lib/rancher/k3s/server/node-token)  # trên master
      #   sudo /vagrant/../k3s-setup/join-worker.sh 192.168.243.10 $TOKEN  # trên worker
    end
  end
end
